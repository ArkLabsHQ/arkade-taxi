# arkade-taxi against a local arkade-regtest stack.
#
#   cp .env.regtest.example .env.regtest
#
# The copy is deliberately named `.env.regtest`, not `.env`: with
# ArkLabsHQ/arkade-regtest checked out at ./arkade-regtest, its CLI reads
# `../.env.regtest` as its own override file. One file therefore configures both
# the stack and the service. arkade-regtest ignores the TAXI_* names and this
# service ignores the rest.
#
# Every variable below is read by `loadConfig` in packages/app/src/config.ts.
# See docs/environment.md for what breaks when one is wrong.

# ── The stack ────────────────────────────────────────────────────────────────
# base + ark + emulator. The taxi needs arkd and the emulator and nothing else.
REGTEST_PROFILES=emulator
# 0 disables the auto-miner. Leave it on and the chain tip advances under your
# tests: arkd's regtest locktimes are block-denominated, so background mining
# fires VTXO expiry and sweeps mid-test and the locktime scenarios go
# non-deterministic. Mine explicitly with `node arkade-regtest/regtest.mjs mine`.
AUTOMINE_INTERVAL=0

# ── The service ──────────────────────────────────────────────────────────────

# SQLite file. `:memory:` is the default and loses the ledger on restart, which
# for an operator means losing the record of who owes what.
TAXI_DB_PATH=.data/taxi-regtest.db

# HTTP listener. Default 8080.
TAXI_HTTP_PORT=8080

# Absolute URLs, both required. arkade-regtest publishes arkd on 7070 and the
# emulator on 7073 (ARKD_PORT / EMULATOR_PORT in its .env.defaults).
TAXI_ARKD_URL=http://localhost:7070
TAXI_EMULATOR_URL=http://localhost:7073

# 32-byte secp256k1 private key, 64 lowercase hex. The operator signs its own
# funding inputs at lockup with this; it is never a covenant signer. Generate a
# throwaway one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TAXI_OPERATOR_PRIVKEY=

# 32-byte x-only public keys, 64 hex each. These are the keys every covenant
# leaf is built from, so a wrong value yields an address nobody can spend.
#
#   arkd:     curl -s http://localhost:7070/v1/info     | jq -r .signerPubkey
#   emulator: curl -s http://localhost:7073/v1/info     | jq -r .signerPubkey
#
# Both serve a COMPRESSED key (66 hex, leading 02/03). Drop the first byte —
# these fields take the 64-hex x-only form.
TAXI_SERVER_PUBKEY=
TAXI_EMULATOR_PUBKEY=

# The dust unit the operator fronts, and the floor on any virtual output.
# TAXI_VTXO_MIN_AMOUNT must not exceed TAXI_DUST. Both must match what arkd
# advertises, or the covenant pins amounts the Arkade Service will not accept.
# A default-configured arkd sets vtxoMinAmount = dustAmount, which closes the
# sub-dust window entirely; scenario 4 needs a stack where it is genuinely open.
TAXI_DUST=330
TAXI_VTXO_MIN_AMOUNT=1

# trace | debug | info | warn | error | fatal. Default info.
TAXI_LOG_LEVEL=debug

# Bech32m prefix for derived covenant addresses. `ark` on mainnet, `tark` on
# regtest, testnet, signet and mutinynet. Default `ark`, so regtest must set it.
TAXI_ADDRESS_HRP=tark
