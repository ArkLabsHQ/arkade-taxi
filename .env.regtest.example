# Manual isolated regtest only; use pnpm e2e:stack for full release acceptance.
# See docs/environment.md and docs/runbook.md; inject the private key securely.
REGTEST_PROFILES=emulator
AUTOMINE_INTERVAL=0

TAXI_DB_PATH=.data/taxi-regtest.db
TAXI_HTTP_PORT=8080
TAXI_ARKD_URL=http://localhost:7070
TAXI_EMULATOR_URL=http://localhost:7073

TAXI_MIN_EXPIRY_HEADROOM_BLOCKS=144
TAXI_RECOVERY_BROADCAST_BLOCKS=72
TAXI_RECOVERY_CRITICAL_BLOCKS=12
TAXI_MIN_EXPIRY_HEADROOM_SECONDS=86400
TAXI_RECOVERY_BROADCAST_SECONDS=43200
TAXI_RECOVERY_CRITICAL_SECONDS=7200
TAXI_RECONCILE_INTERVAL_MS=30000
TAXI_OPERATOR_MIN_RESERVE_SATS=10000
TAXI_PROCEEDS_MAX_FEE_SATS=0

TAXI_OPERATOR_PRIVKEY=
TAXI_LOG_LEVEL=info
