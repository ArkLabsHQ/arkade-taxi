{
    "name": "@arkade-taxi/client",
    "version": "1.1.4",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./wallet": {
            "types": "./dist/wallet/index.d.ts",
            "default": "./dist/wallet/index.js"
        }
    },
    "scripts": {
        "build": "tsup src/index.ts src/wallet/index.ts --format esm --target es2022 --dts --sourcemap",
        "test:e2e": "vitest run --config vitest.e2e.config.ts"
    },
    "dependencies": {
        "@arkade-taxi/covenant": "workspace:*",
        "@arkade-taxi/protocol": "workspace:*",
        "@arkade-os/sdk": "0.5.14",
        "@noble/hashes": "^2.0.1",
        "@scure/base": "^2.0.0",
        "@scure/btc-signer": "2.4.1"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/ArkLabsHQ/arkade-taxi.git",
        "directory": "packages/client"
    }
}
