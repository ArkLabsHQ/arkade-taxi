{
    "name": "dust-broker",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@10.34.5",
    "engines": {
        "node": ">=22.6.0 <27",
        "pnpm": ">=10"
    },
    "scripts": {
