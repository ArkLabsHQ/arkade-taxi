{
    "name": "arkade-taxi",
    "private": true,
    "version": "1.1.4",
    "type": "module",
    "packageManager": "pnpm@10.34.5",
    "engines": {
        "node": ">=22.13.0 <27",
        "pnpm": ">=10"
    },
    "scripts": {
        "build": "pnpm -r build",
        "typecheck": "tsc -p tsconfig.base.json --noEmit",
        "test": "vitest run --exclude e2e",
        "test:harness": "vitest run scripts/test/harness.test.ts",
        "e2e:stack": "node scripts/e2e-stack.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "artifact": "node scripts/gen-artifact.mjs",
        "test:integration:client": "node scripts/client-regtest.mjs cycle",
        "regtest:up:client": "node scripts/client-regtest.mjs up",
        "regtest:down:client": "node scripts/client-regtest.mjs down",
        "regtest:reset:client": "node scripts/client-regtest.mjs reset",
        "regtest:test:client": "node scripts/client-regtest.mjs test",
        "lint": "eslint ."
    },
    "devDependencies": {
        "@arkade-os/sdk": "0.5.14",
        "@arkade-os/swap": "0.1.16",
        "@eslint/js": "^10.0.1",
        "@noble/curves": "^2.4.0",
        "@scure/base": "^2.4.0",
        "@types/node": "^24.13.3",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.13.0",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^3.2.7"
    }
}
