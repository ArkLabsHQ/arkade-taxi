{
    "name": "arkade-taxi",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@10.34.5",
    "engines": {
        "node": ">=22.6.0 <27",
        "pnpm": ">=10"
    },
    "scripts": {
        "build": "pnpm -r build",
        "typecheck": "tsc -p tsconfig.base.json --noEmit",
        "test": "vitest run --exclude e2e",
        "test:harness": "vitest run scripts/test/harness.test.ts",
        "e2e:stack": "node scripts/e2e-stack.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "vectors": "node scripts/gen-vectors.mjs",
        "verify:artifacts": "node scripts/carrier-artifacts/verify.mjs",
        "verify:artifacts:battery": "node scripts/carrier-artifacts/fault-battery.mjs",
        "lint": "eslint ."
    },
    "devDependencies": {
        "@arkade-os/sdk": "file:./vendor/carrier/arkade-os-sdk-0.4.77-23c6d353.tgz",
        "@eslint/js": "^10.0.1",
        "@noble/curves": "^2.4.0",
        "@scure/base": "^2.4.0",
        "@types/node": "^24.13.3",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^3.2.7"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "better-sqlite3",
            "esbuild"
        ],
        "overrides": {
            "@arkade-os/sdk": "file:./vendor/carrier/arkade-os-sdk-0.4.77-23c6d353.tgz",
            "@arkade-os/swap": "file:./vendor/carrier/arkade-os-swap-0.0.23-23c6d353.tgz"
        }
    }
}
