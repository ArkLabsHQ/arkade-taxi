{
    "name": "arkade-taxi",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@10.34.5",
    "engines": {
        "node": ">=22.6.0 <27",
        "pnpm": ">=10"
    },
    "scripts": {
        "build": "pnpm -r build",
        "typecheck": "tsc -p tsconfig.base.json --noEmit",
        "test": "vitest run --exclude e2e",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "vectors": "node scripts/gen-vectors.mjs"
    },
    "devDependencies": {
        "@arkade-os/sdk": "0.4.67",
        "@noble/curves": "^2.4.0",
        "@scure/base": "^2.4.0",
        "@types/node": "^24.13.3",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "vitest": "^3.2.7"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "better-sqlite3",
            "esbuild"
        ]
    }
}
